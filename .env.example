# Neon Postgres (Vercel Storage integration provides DATABASE_URL / POSTGRES_URL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Upstash Redis (Vercel KV integration). Optional: if missing, rate limiting and cron lock degrade gracefully.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Required in production for /api/cron/automations
CRON_SECRET=""
